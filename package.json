{
  "name": "dsh-line-height",
  "version": "0.2.0",
  "description": "Client-side DSH Web GUI theme with presets: compact hover-revealed header tabs, feathered top edge, calmer typography, a configurable transcript column and a selectable composer status row.",
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": {
      "default": "./lib/index.mjs"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "license": "MIT",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "theme",
    "ui",
    "client-plugin",
    "preset"
  ],
  "author": "dsh-line-height contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sumnyte/dsh-line-height.git"
  },
  "homepage": "https://github.com/Sumnyte/dsh-line-height#readme",
  "bugs": {
    "url": "https://github.com/Sumnyte/dsh-line-height/issues"
  }
}
