{
  "name": "dsh-clean-ui",
  "version": "0.2.32",
  "description": "Cleaner client-side UI theme for the DSH Web GUI, with presets: compact header, hover tabs, tunable typography, composer width and height, selectable status row and per-button header hiding.",
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": {
      "default": "./lib/index.mjs"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs",
    "locale"
  ],
  "license": "MIT",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "theme",
    "ui",
    "client-plugin",
    "preset"
  ],
  "author": "dsh-clean-ui contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sumnyte/dsh-clean-ui.git"
  },
  "homepage": "https://github.com/Sumnyte/dsh-clean-ui#readme",
  "bugs": {
    "url": "https://github.com/Sumnyte/dsh-clean-ui/issues"
  }
}
